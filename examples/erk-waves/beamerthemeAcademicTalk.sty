% ============================================================
% AcademicTalk — a clean Beamer theme for research talks
% White background, thin rules, full-color section dividers.
% Institution-agnostic. Tuned for 16:9 seminar/conference talks.
%
% Adapted from Faust-Donf/beamer-academic (beamerthemeAcademic.sty),
% simplified and re-tuned for talk-style (not thesis-defense) decks.
% ============================================================
\ProvidesPackage{beamerthemeAcademicTalk}[2026/09/01 AcademicTalk Beamer Theme v1.0]

\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}
\RequirePackage{colortbl}

% ---------- Palette ----------
\definecolor{academic-blue}{RGB}{26, 58, 92}
\definecolor{academic-red}{RGB}{139, 0, 0}
\definecolor{academic-green}{RGB}{0, 100, 60}
\definecolor{academic-purple}{RGB}{75, 0, 110}
\definecolor{academic-teal}{RGB}{0, 80, 100}

\definecolor{textgray}{RGB}{90, 90, 90}
\definecolor{lightline}{RGB}{200, 200, 200}
\definecolor{lightbg}{RGB}{238, 242, 246}
\definecolor{inkcolor}{RGB}{34, 34, 34}

\colorlet{accentcolor}{academic-blue}
\colorlet{accentdark}{academic-blue}
\colorlet{accentlight}{academic-blue!12}

\newcommand{\setaccentcolor}[1]{%
  \colorlet{accentcolor}{#1}%
  \colorlet{accentdark}{#1}%
  \colorlet{accentlight}{#1!12}%
  \setbeamercolor{structure}{fg=accentcolor}%
  \setbeamercolor{title}{fg=accentcolor}%
  \setbeamercolor{frametitle}{fg=accentcolor, bg=white}%
  \setbeamercolor{section in head/foot}{fg=white, bg=accentdark}%
  \setbeamercolor{alerted text}{fg=accentcolor}%
  \setbeamercolor{block title}{fg=white, bg=accentcolor}%
}

\newcommand{\useblue}{\setaccentcolor{academic-blue}}
\newcommand{\usered}{\setaccentcolor{academic-red}}
\newcommand{\usegreen}{\setaccentcolor{academic-green}}
\newcommand{\usepurple}{\setaccentcolor{academic-purple}}
\newcommand{\useteal}{\setaccentcolor{academic-teal}}

\setbeamercolor{structure}{fg=accentcolor}
\setbeamercolor{title}{fg=accentcolor}
\setbeamercolor{frametitle}{fg=accentcolor, bg=white}
\setbeamercolor{headline}{fg=textgray, bg=white}
\setbeamercolor{footline}{fg=textgray, bg=white}
\setbeamercolor{section in head/foot}{fg=white, bg=accentdark}
\setbeamercolor{author in head/foot}{fg=textgray, bg=white}
\setbeamercolor{title in head/foot}{fg=textgray, bg=white}
\setbeamercolor{date in head/foot}{fg=textgray, bg=white}
\setbeamercolor{block title}{fg=white, bg=accentcolor}
\setbeamercolor{block body}{fg=black, bg=lightbg}
\setbeamercolor{item}{fg=accentcolor}
\setbeamercolor{enumerate item}{fg=accentcolor}
\setbeamercolor{caption name}{fg=accentcolor}
\setbeamercolor{normal text}{fg=inkcolor}
\setbeamercolor{alerted text}{fg=accentcolor}

\setbeamerfont{title}{size=\fontsize{22pt}{28pt}\selectfont, series=\bfseries, family=\sffamily}
\setbeamerfont{subtitle}{size=\fontsize{13pt}{18pt}\selectfont}
\setbeamerfont{frametitle}{size=\fontsize{16pt}{20pt}\selectfont, series=\bfseries, family=\sffamily}
\setbeamerfont{framesubtitle}{size=\small}
\setbeamerfont{footline}{size=\fontsize{7pt}{9pt}\selectfont}
\setbeamerfont{block title}{size=\normalsize, series=\bfseries}
\setbeamerfont{section in toc}{series=\bfseries}

\setbeamertemplate{itemize item}{\color{accentcolor}\raisebox{0.18ex}{\small\textbullet}}
\setbeamertemplate{itemize subitem}{\color{accentcolor}\raisebox{0.18ex}{\scriptsize\textbullet}}
\setbeamertemplate{navigation symbols}{}

% Top-aligned frames by default.
\beamer@centeredfalse
\setbeamertemplate{headline}{}

% Footer: thin rule + gray meta + progress bar.
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox to \paperwidth{%
    \hspace*{0.45cm}\textcolor{lightline}{\rule{0.92\paperwidth}{0.4pt}}\hspace*{0.45cm}%
  }%
  \vskip2pt%
  \hbox{%
    \begin{beamercolorbox}[wd=.34\paperwidth, ht=2.0ex, dp=0.7ex, leftskip=.45cm]{author in head/foot}%
      \usebeamerfont{footline}\insertshortauthor~~\insertshortinstitute%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.40\paperwidth, ht=2.0ex, dp=0.7ex, center]{title in head/foot}%
      \usebeamerfont{footline}\insertshorttitle%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.26\paperwidth, ht=2.0ex, dp=0.7ex, rightskip=.45cm plus1fil]{date in head/foot}%
      \usebeamerfont{footline}\hfill
      \textcolor{accentcolor}{\bfseries\insertframenumber}\,/\,\inserttotalframenumber%
    \end{beamercolorbox}%
  }%
  \vskip2pt%
  \ifnum\inserttotalframenumber>0
    \pgfmathparse{\insertframenumber/\inserttotalframenumber}%
    {\color{accentcolor}\rule{\pgfmathresult\paperwidth}{2.4pt}}%
  \fi
}

% Frame title with an accent underline.
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \vskip7pt
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
  \expandafter\ifstrempty\expandafter{\insertframesubtitle}{}{%
    {\usebeamerfont{framesubtitle}\color{textgray}\insertframesubtitle\par}%
  }%
  \nointerlineskip
  \vskip3pt
  {\color{accentcolor}\hrule height 1.15pt}%
  \nointerlineskip
  \vskip5pt
}

% ---------- Title-page fields (hidden when empty) ----------
\newcommand{\supervisor}{}
\newcommand{\setsupervisor}[1]{\renewcommand{\supervisor}{#1}}
\newcommand{\venueline}{}
\newcommand{\setvenue}[1]{\renewcommand{\venueline}{#1}}
\newcommand{\themelogo}{}
\newcommand{\setlogo}[1]{\renewcommand{\themelogo}{#1}}

\setbeamertemplate{title page}{%
  \vspace{1.15cm}%
  \begin{center}
    \ifx\themelogo\empty\else
      \includegraphics[height=1.05cm]{\themelogo}\\[0.35cm]
    \fi
    {\color{textgray}\small\insertinstitute}\\[0.95cm]
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle}\\[0.22cm]
    {\usebeamerfont{subtitle}\color{textgray}\insertsubtitle}\\[0.38cm]
    {\color{accentcolor}\rule{0.52\textwidth}{0.8pt}}
  \end{center}
  \vspace{0.7cm}%
  \begin{center}
    {\large\insertauthor}\\[6pt]
    \ifx\supervisor\empty\else
      {\color{textgray}\small\supervisor}\\[5pt]
    \fi
    \ifx\venueline\empty\else
      {\color{textgray}\small\venueline}\\[5pt]
    \fi
  \end{center}
  \vfill
  \begin{center}
    {\color{textgray}\small\insertdate}
  \end{center}
  \vspace{0.55cm}%
}

% Section divider: full-color page + circled number.
\newcommand{\sectiondivider}[2]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture, overlay]
      \fill[accentcolor] (current page.north west) rectangle (current page.south east);
      \node[circle, draw=white, line width=1.15pt, minimum size=1.85cm,
            text=white, font=\sffamily\fontsize{30pt}{36pt}\selectfont\bfseries]
            at ([yshift=0.55cm]current page.center) {#1};
      \node[white, font=\sffamily\fontsize{22pt}{28pt}\selectfont\bfseries]
            at ([yshift=-1.35cm]current page.center) {#2};
    \end{tikzpicture}
  \end{frame}
}

% Small italic note under a frame title (e.g. "cf. paper §3.2").
\newcommand{\chapnote}[1]{%
  {\scriptsize\color{textgray}\itshape #1\par}\vskip2pt%
}

% Figure caption line.
\newcommand{\figcap}[1]{%
  \vskip-2pt{\centering\scriptsize\itshape\color{textgray}#1\par}%
}

% Take-home box: light fill + accent left rule.
\newcommand{\keybox}[1]{%
  \par\vspace{0.18cm}%
  \noindent
  \begin{tikzpicture}
    \node[fill=accentlight, inner sep=8pt, inner xsep=11pt,
          text width=0.92\linewidth, align=left, font=\small] (kb) {#1};
    \draw[accentcolor, line width=2.6pt] (kb.north west) -- (kb.south west);
  \end{tikzpicture}
  \par
}

% Table helpers.
\newcommand{\headrow}{\rowcolor{accentcolor}}
\newcommand{\rowaccent}{\rowcolor{accentlight}}
\newcommand{\headcell}[1]{\color{white}\bfseries #1}

% One-line statement slide (full color).
\newcommand{\statementframe}[1]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture, overlay]
      \fill[accentcolor] (current page.north west) rectangle (current page.south east);
      \node[text=white, font=\sffamily\bfseries\fontsize{22pt}{32pt}\selectfont,
            text width=0.76\paperwidth, align=center]
        at (current page.center) {#1};
    \end{tikzpicture}
  \end{frame}
}

% Three headline numbers: \statrow{28.4}{BLEU en-de}{41.8}{BLEU en-fr}{3.5 d}{train}
\newcommand{\statrow}[6]{%
  \vspace{0.35cm}%
  \noindent
  \begin{minipage}{0.32\linewidth}\centering
    {\color{accentcolor}\sffamily\bfseries\fontsize{28pt}{32pt}\selectfont #1}\\[4pt]
    {\color{textgray}\small #2}
  \end{minipage}\hfill
  \begin{minipage}{0.32\linewidth}\centering
    {\color{accentcolor}\sffamily\bfseries\fontsize{28pt}{32pt}\selectfont #3}\\[4pt]
    {\color{textgray}\small #4}
  \end{minipage}\hfill
  \begin{minipage}{0.32\linewidth}\centering
    {\color{accentcolor}\sffamily\bfseries\fontsize{28pt}{32pt}\selectfont #5}\\[4pt]
    {\color{textgray}\small #6}
  \end{minipage}
  \par
}

% Three parallel short claims: \hyporow{H1}{...}{H2}{...}{H3}{...}
\newcommand{\hyporow}[6]{%
  \vspace{0.2cm}%
  \noindent
  \begin{minipage}[t]{0.31\linewidth}
    {\color{accentcolor}\rule{\linewidth}{1.6pt}}\\[6pt]
    {\color{accentcolor}\bfseries #1}\\[4pt] #2
  \end{minipage}\hfill
  \begin{minipage}[t]{0.31\linewidth}
    {\color{accentcolor}\rule{\linewidth}{1.6pt}}\\[6pt]
    {\color{accentcolor}\bfseries #3}\\[4pt] #4
  \end{minipage}\hfill
  \begin{minipage}[t]{0.31\linewidth}
    {\color{accentcolor}\rule{\linewidth}{1.6pt}}\\[6pt]
    {\color{accentcolor}\bfseries #5}\\[4pt] #6
  \end{minipage}
  \par
}

\setbeamertemplate{section in toc}{%
  \leavevmode
  {\color{accentcolor}\bfseries\inserttocsectionnumber}\hspace{0.7em}%
  \inserttocsection\par
  \vspace{0.35em}%
}
\setbeamertemplate{subsection in toc}{%
  \hspace{1.6em}{\color{textgray}\small\inserttocsubsection}\par
}
\AtBeginSection[]{}

% Closing frame: one line, no "THANK YOU".
\newcommand{\thanksframe}[3][]{%
  \begin{frame}[plain]
    \vbox to \paperheight\bgroup
      \vfill
      \ifstrempty{#1}{}{%
        \begin{center}\includegraphics[width=0.72\paperwidth]{#1}\end{center}
        \vspace{0.45cm}%
      }%
      \begin{center}
        {\color{accentcolor}\sffamily\bfseries\fontsize{24pt}{32pt}\selectfont #2}\\[0.45cm]
        {\color{accentcolor}\rule{0.28\textwidth}{0.75pt}}\\[0.4cm]
        {\color{textgray}\small #3}
      \end{center}
      \vfill
    \egroup
  \end{frame}
}

\endinput
